# Copy this file to .env and fill in your values

# Connection string from Supabase (Project Settings > Database > Connection string > URI)
# or Neon (Dashboard > Connection Details). Must include ?sslmode=require for both.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Port the API server listens on
PORT=3001

# Comma-separated list of origins allowed to call this API.
# Add your deployed frontend's URL here too once you host it.
ALLOWED_ORIGINS=http://localhost:5173

# Secret used to sign login tokens. Use a long random string —
# e.g. run `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# and paste the output here. Keep this out of git, same as DATABASE_URL.
JWT_SECRET=change-this-to-a-long-random-string

# Optional. If set, anyone who registers with this code gets admin rights
# (can edit and delete any trader's data, not just their own). Leave blank
# to disable admin signup entirely — you can still promote someone via SQL,
# see migrations/003_add_admin.sql. Share this code only with people you
# actually want as admins.
ADMIN_SIGNUP_CODE=
